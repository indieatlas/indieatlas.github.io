---
import RankingList from '../components/RankingList.astro';
import EmptyState from '../components/EmptyState.astro';
import ExternalLink from '../components/ExternalLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { amazonBestsellersUrl, AMAZON_DISCLOSURE } from '../lib/amazon.ts';
import { getRanking } from '../lib/data.ts';
import { formatDate } from '../lib/format.ts';
import { paths } from '../lib/urls.ts';

const ranking = getRanking();
const title = ranking.source === 'steam' ? 'Steam のインディー売れ筋' : 'Amazon の売れ筋';
const bestsellers = amazonBestsellersUrl();
---

<BaseLayout
  title={title}
  description="いま売れているゲーム。Amazon の売れ筋か、Steam のインディーの売上上位を並べています。"
  path={paths.ranking()}
>
  <div class="container section">
    <h1 class="page-title">{title}</h1>
    {ranking.items.length > 0 ? (
      <>
        <RankingList items={ranking.items} wide={ranking.source === 'steam'} />
        <p class="note small muted">
          {ranking.fetchedAt && (
            <>
              <time datetime={ranking.fetchedAt}>{formatDate(ranking.fetchedAt)}</time> 時点。
            </>
          )}
          {ranking.source === 'steam'
            ? 'Steam の日本での売上上位のうち、インディーのタグが付いたゲームを並べています。家庭用ゲーム機版がある作品は Amazon での検索結果に、PC だけの作品は Steam のストアにリンクしています。'
            : 'ゲームソフトだけを、Amazon の売れ筋の順位で並べています。'}
          {AMAZON_DISCLOSURE}
        </p>
      </>
    ) : (
      <EmptyState title="売れ筋はいま表示できません">
        {bestsellers && (
          <p>
            <ExternalLink href={bestsellers} sponsored>
              Amazon のゲームの売れ筋ランキング
            </ExternalLink>
            で確かめられます。
          </p>
        )}
      </EmptyState>
    )}
  </div>
</BaseLayout>

<style>
  .note {
    margin-top: var(--space-5);
  }
</style>
