---
import ArticleIndex from '../../components/ArticleIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { paths } from '../../lib/urls.ts';
---

<BaseLayout
  title="記事"
  description="収録作品を扱った外部の媒体の記事。見出しと原文へのリンクを掲載しています。"
  path={paths.articles()}
  current="articles"
>
  <div class="container section">
    <h1 class="page-title">記事</h1>
    <ArticleIndex page={1} />
  </div>
</BaseLayout>
