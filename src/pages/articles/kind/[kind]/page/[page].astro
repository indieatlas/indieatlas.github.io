---
import type { ArticleKind } from '../../../../../../schema/common.ts';
import ArticleIndex from '../../../../../components/ArticleIndex.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { getArticles } from '../../../../../lib/data.ts';
import { ARTICLE_KIND_LABELS, ARTICLE_TABS } from '../../../../../lib/format.ts';
import { ARTICLES_PER_PAGE, pageCount } from '../../../../../lib/listing.ts';
import { paths } from '../../../../../lib/urls.ts';

export function getStaticPaths() {
  return ARTICLE_TABS.flatMap((kind) => {
    const total = pageCount(getArticles().filter((a) => a.kind === kind).length, ARTICLES_PER_PAGE);
    return Array.from({ length: total - 1 }, (_, i) => ({ params: { kind, page: String(i + 2) } }));
  });
}
const kind = Astro.params.kind as ArticleKind;
const page = Number(Astro.params.page);
---

<BaseLayout
  title={`記事: ${ARTICLE_KIND_LABELS[kind]}（${page}ページ目）`}
  path={paths.articleKind(kind, page)}
  current="articles"
>
  <div class="container section">
    <h1 class="page-title">記事: {ARTICLE_KIND_LABELS[kind]}</h1>
    <ArticleIndex kind={kind} page={page} />
  </div>
</BaseLayout>
