---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDevelopers, getGame } from '../../lib/data.ts';
import { paths, url } from '../../lib/urls.ts';

// 開発元とパブリッシャーの一覧。収録作品の多い順
const developers = [...getDevelopers()].sort(
  (a, b) =>
    new Set([...b.developed, ...b.published]).size - new Set([...a.developed, ...a.published]).size ||
    a.name.localeCompare(b.name, 'ja'),
);
const ROLE = { developer: '開発', publisher: 'パブリッシャー' } as const;
---

<BaseLayout
  title="開発元・パブリッシャー"
  description="収録作品の開発元とパブリッシャーの一覧。スタジオごとに作品をたどれます。"
  path={paths.developers()}
  current="games"
>
  <div class="container section">
    <h1 class="page-title">開発元・パブリッシャー</h1>
    <ul class="dev-grid">
      {developers.map((d) => {
        const ids = [...new Set([...d.developed, ...d.published])];
        const thumbs = ids.map((id) => getGame(id)).filter((g) => g?.image).slice(0, 3);
        return (
          <li>
            <a class="dev-card" href={url(paths.developer(d.id))}>
              <span class="thumbs" aria-hidden="true">
                {thumbs.map((g) => (
                  <img src={g!.image!.url} alt="" width="460" height="215" loading="lazy" decoding="async" />
                ))}
              </span>
              <span class="body">
                <span class="name">{d.name}</span>
                <span class="meta">
                  {d.roles.map((r) => ROLE[r]).join('・')} ・ {ids.length}作品
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .dev-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }
  .dev-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out);
  }
  .dev-card:hover,
  .dev-card:focus-visible {
    background: var(--color-surface-raised);
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
    outline: none;
  }
  .thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 2px;
    aspect-ratio: 460 / 150;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
  }
  .name {
    font-weight: 800;
  }
  .meta {
    font-size: var(--text-xsmall);
    color: var(--color-text-muted);
  }
</style>
