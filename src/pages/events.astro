---
import EmptyState from '../components/EmptyState.astro';
import EventItem from '../components/EventItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEvents } from '../lib/data.ts';
import { paths } from '../lib/urls.ts';

const events = getEvents();
const upcoming = events.filter((e) => e.phase !== 'past');
const past = events.filter((e) => e.phase === 'past').reverse();
const byMonth = new Map<string, typeof upcoming>();
for (const e of upcoming) {
  const key = e.startKey.slice(0, 7);
  byMonth.set(key, [...(byMonth.get(key) ?? []), e]);
}
const monthLabel = (k: string) => `${Number(k.slice(0, 4))}年${Number(k.slice(5, 7))}月`;
---

<BaseLayout
  title="イベント"
  description="インディーゲームの展示会、発表配信、オンラインのフェスなどの日程をまとめたカレンダー。"
  path={paths.events()}
  current="events"
>
  <div class="container section">
    <p class="eyebrow">Calendar</p>
    <h1 class="page-title">イベント</h1>
    <p class="muted lede">
      インディーゲームの展示会、試遊会、発表配信、オンラインのフェスの日程です。日程は公式のページや告知の記事で確かめたものを載せ、変更があれば更新します。
    </p>
    {upcoming.length === 0 ? (
      <EmptyState title="予定されているイベントはまだありません" />
    ) : (
      [...byMonth.entries()].map(([k, list]) => (
        <section class="month" aria-labelledby={`m-${k}`}>
          <h2 id={`m-${k}`}>
            <span class="ym">{monthLabel(k)}</span>
            <span class="count">{list.length}件</span>
          </h2>
          {list.map((e) => (
            <EventItem event={e} />
          ))}
        </section>
      ))
    )}
    {past.length > 0 && (
      <details class="past">
        <summary>
          <h2>終わったイベント（{past.length}件）</h2>
        </summary>
        {past.map((e) => (
          <EventItem event={e} />
        ))}
      </details>
    )}
  </div>
</BaseLayout>

<style>
  .lede {
    max-width: var(--measure);
    margin-bottom: var(--space-7);
  }
  .month {
    margin-bottom: var(--space-8);
  }
  .month h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-strong);
    font-size: 1.375rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .past summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .past summary h2 {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>
