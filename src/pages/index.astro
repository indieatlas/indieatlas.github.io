---
import ArticleList from '../components/ArticleList.astro';
import CollectionCard from '../components/CollectionCard.astro';
import GameGrid from '../components/GameGrid.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagChip from '../components/TagChip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getCollections, getStats, getTags, gamesByAdded } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';

const stats = getStats();
const byAdded = gamesByAdded();

// 最新情報: 掲載日の新しい記事を6件（articles.json は新しい順）
const articles = getArticles();
const news = articles.slice(0, 6);
const latest = articles.slice(6, 12);

const recent = byAdded.slice(0, 12);
const recentIds = new Set(recent.map((g) => g.id));

// 最近情報が充実した作品: enrichedAt の新しい順に8件。最近収録した作品は除く
const enriched = byAdded
  .filter((g) => g.enrichedAt && !recentIds.has(g.id))
  .sort((a, b) => (a.enrichedAt! < b.enrichedAt! ? 1 : a.enrichedAt! > b.enrichedAt! ? -1 : 0))
  .slice(0, 8);

// コレクション: featured を最大6件。足りなければ更新の新しい順で補う
const all = getCollections();
const featured = all.filter((c) => c.featured);
const rest = all.filter((c) => !c.featured).sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));
const collections = [...featured, ...rest].slice(0, 6);

// よく使われるタグ（検索の入口）
const popularTags = [...getTags()].sort((a, b) => b.gameCount - a.gameCount).slice(0, 10);
let n = 0;
const idx = () => String(++n).padStart(2, '0');
---

<BaseLayout path={paths.home()}>
  <h1 class="visually-hidden">Indie Atlas — まだ知らないインディーゲームに出会う</h1>
  {news.length > 0 && <HeroCarousel articles={news} />}

  <div class="container">
    <section class="quick" aria-label="作品を探す">
      <form class="quick-search" action={url(paths.games())} method="get" role="search">
        <label for="home-q" class="label">
          <span class="en" aria-hidden="true">
            Search
          </span>
          <span>{stats.games}作品から探す</span>
        </label>
        <input id="home-q" name="q" type="search" placeholder="タイトル、タグ、開発者で検索" autocomplete="off" />
        <button type="submit" class="button button-primary">
          検索
        </button>
      </form>
      <ul class="chip-row" aria-label="よく使われるタグ">
        {popularTags.map((t) => (
          <li>
            <TagChip id={t.id} label={t.label} />
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="recent-h">
      <SectionHeading
        id="recent-h"
        index={idx()}
        en="New arrivals"
        title="最近収録した作品"
        linkPath={paths.games()}
        linkLabel="すべての作品"
      />
      <GameGrid games={recent} eagerCount={0} />
    </section>

    {enriched.length > 0 && (
      <section class="section" aria-labelledby="enriched-h">
        <SectionHeading id="enriched-h" index={idx()} en="Updated" title="最近情報が充実した作品" />
        <GameGrid games={enriched} notes={Object.fromEntries(enriched.map((g) => [g.id, g.enrichedNote ?? '']))} />
      </section>
    )}

    {collections.length > 0 && (
      <section class="section" aria-labelledby="collections-h">
        <SectionHeading
          id="collections-h"
          index={idx()}
          en="Collections"
          title="コレクション"
          linkPath={paths.collections()}
          linkLabel="すべてのコレクション"
        />
        <ul class="collection-grid">
          {collections.map((c) => (
            <li>
              <CollectionCard collection={c} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {latest.length > 0 && (
      <section class="section" aria-labelledby="news-h">
        <SectionHeading
          id="news-h"
          index={idx()}
          en="Latest news"
          title="新着の記事"
          linkPath={paths.articles()}
          linkLabel="すべての記事"
        />
        <ArticleList articles={latest} />
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .quick {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    clip-path: polygon(0 0, calc(100% - var(--cut-m)) 0, 100% var(--cut-m), 100% 100%, 0 100%);
  }
  .quick-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .label {
    display: grid;
    font-weight: 700;
    line-height: 1.3;
  }
  .en {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-warm);
  }
  .quick-search input {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 0;
    border-bottom: 2px solid var(--color-signal);
    background: var(--color-bg);
  }
  .quick-search input:focus-visible {
    outline: 2px solid var(--color-accent-warm);
    outline-offset: 0;
    border-radius: 0;
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
