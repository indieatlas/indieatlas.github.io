---
import ArticleList from '../components/ArticleList.astro';
import CollectionCard from '../components/CollectionCard.astro';
import EventCard from '../components/EventCard.astro';
import GameGrid from '../components/GameGrid.astro';
import NewsMosaic from '../components/NewsMosaic.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { gamesByAdded, getCollections, getEvents, getRanking, homeNews } from '../lib/data.ts';
import RankingList from '../components/RankingList.astro';
import { amazonBestsellersUrl } from '../lib/amazon.ts';
import ExternalLink from '../components/ExternalLink.astro';
import { paths } from '../lib/urls.ts';

const bestsellers = amazonBestsellersUrl();
const ranking = getRanking();
const rankingTitle = ranking.source === 'steam' ? 'Steam のインディー売れ筋' : 'Amazon の売れ筋';

const byAdded = gamesByAdded();

// 先頭は大きく見せる記事1件と、横で2件ずつ切り替わる6件。続く16件を下の一覧に出す
const news = homeNews(7, 0);
const shownNews = new Set(news.featured.map((a) => a.id));
const moreNews = homeNews(0, 40).rest.filter((a) => !shownNews.has(a.id)).slice(0, 16);

// 長い期間の催し（期間中のもの）は、いつ見ても先頭に残るので出さない
const events = getEvents()
  .filter((e) => e.phase === 'upcoming' || e.phase === 'ongoing')
  .slice(0, 5);

// 作品の区画は1行だけにする
const recent = byAdded.slice(0, 5);
const recentIds = new Set(recent.map((g) => g.id));

// 最近情報が充実した作品: enrichedAt の新しい順に5件。ほかの区画に出した作品は除く
const enriched = byAdded
  .filter((g) => g.enrichedAt && !recentIds.has(g.id))
  .sort((a, b) => (a.enrichedAt! < b.enrichedAt! ? 1 : a.enrichedAt! > b.enrichedAt! ? -1 : 0))
  .slice(0, 5);

// コレクション: featured を優先し、足りなければ更新の新しい順で補う
const all = getCollections();
const featured = all.filter((c) => c.featured);
const rest = all.filter((c) => !c.featured).sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));
const collections = [...featured, ...rest].slice(0, 4);
---

<BaseLayout path={paths.home()}>
  <h1 class="visually-hidden">Indie Atlas — まだ知らないインディーゲームに出会う</h1>
  <div class="container home">
    {news.featured.length > 0 && <NewsMosaic featured={news.featured} />}

    {events.length > 0 && (
      <section class="section" aria-labelledby="events-h">
        <SectionHeading id="events-h" title="イベント" linkPath={paths.events()} linkLabel="カレンダー" />
        <ul class="event-row">
          {events.map((e) => (
            <li>
              <EventCard event={e} />
            </li>
          ))}
        </ul>
      </section>
    )}


    <section class="section" aria-labelledby="recent-h">
      <SectionHeading id="recent-h" title="最近収録した作品" linkPath={paths.games()} linkLabel="すべての作品" />
      <GameGrid games={recent} eagerCount={0} dateMode="none" />
    </section>

    {enriched.length > 0 && (
      <section class="section" aria-labelledby="enriched-h">
        <SectionHeading id="enriched-h" title="情報が増えた作品" />
        <GameGrid games={enriched} dateMode="none" notes={Object.fromEntries(enriched.map((g) => [g.id, g.enrichedNote ?? '']))} />
      </section>
    )}

    {collections.length > 0 && (
      <section class="section" aria-labelledby="collections-h">
        <SectionHeading id="collections-h" title="コレクション" linkPath={paths.collections()} />
        <ul class="collection-grid">
          {collections.map((c) => (
            <li>
              <CollectionCard collection={c} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {ranking.items.length > 0 ? (
      <section class="section" aria-labelledby="ranking-h">
        <SectionHeading id="ranking-h" title={rankingTitle} linkPath={paths.ranking()} />
        <RankingList items={ranking.items.slice(0, 10)} layout="row" wide={ranking.source === 'steam'} />
      </section>
    ) : (
      bestsellers && (
        <p class="ranking-link">
          <ExternalLink href={bestsellers} sponsored>
            Amazon のゲーム売れ筋ランキング
          </ExternalLink>
        </p>
      )
    )}

    {moreNews.length > 0 && (
      <section class="section" aria-labelledby="news-h">
        <SectionHeading id="news-h" title="記事" linkPath={paths.articles()} />
        <ArticleList articles={moreNews} columns={2} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ホームは情報を詰めて並べる。区画どうしの間をつめ、見出しを小さくする */
  .home :global(.section) {
    padding-block: var(--space-6) var(--space-2);
  }
  .home :global(.section-heading) {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
  }
  .home :global(.section-heading h2) {
    font-size: 1.25rem;
  }
  .home :global(.game-grid) {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .home :global(.article-item) {
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
  }
  /* 5列に収まらない幅では、1行のまま横にスクロールする */
  @media (max-width: 1100px) {
    .home :global(.game-grid) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - 2 * var(--space-4)) / 3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-block: 4px;
    }
    .home :global(.game-grid > li) {
      scroll-snap-align: start;
    }
  }
  .home :global(.game-card__body) {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  /* スマートフォンでは2枚ほどを見せて、機種などの細かい情報は省く */
  @media (max-width: 640px) {
    .home :global(.game-grid) {
      grid-auto-columns: 44%;
      gap: var(--space-3);
    }
    .home :global(.game-card__meta),
    .home :global(.game-card__original),
    .home :global(.game-card__note) {
      display: none;
    }
    .home :global(.game-card__title) {
      font-size: 0.875rem;
    }
  }
  /* イベントは1行だけ。入りきらない分は横にスクロールする */
  .event-row {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * var(--space-4)) / 5);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 4px 0;
  }
  .event-row li {
    scroll-snap-align: start;
  }
  @media (max-width: 1023px) {
    .event-row {
      grid-auto-columns: 42%;
    }
  }
  @media (max-width: 640px) {
    .event-row {
      grid-auto-columns: 72%;
    }
  }
  .ranking-link {
    margin: var(--space-6) 0 0;
  }
  .ranking-link :global(a) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 56px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }
  .ranking-link :global(a:hover) {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
