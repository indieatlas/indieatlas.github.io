---
import ArticleList from '../components/ArticleList.astro';
import CollectionCard from '../components/CollectionCard.astro';
import EventCard from '../components/EventCard.astro';
import GameGrid from '../components/GameGrid.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getCollections, getEvents, gamesByAdded } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';

const byAdded = gamesByAdded();

// 最新情報: 掲載日の新しい記事を6件（articles.json は新しい順）
const articles = getArticles();
const news = articles.slice(0, 6);
const latest = articles.slice(6, 12);

const recent = byAdded.slice(0, 10);
const events = getEvents()
  .filter((e) => e.phase !== 'past')
  .slice(0, 4);
const recentIds = new Set(recent.map((g) => g.id));

// 最近情報が充実した作品: enrichedAt の新しい順に8件。最近収録した作品は除く
const enriched = byAdded
  .filter((g) => g.enrichedAt && !recentIds.has(g.id))
  .sort((a, b) => (a.enrichedAt! < b.enrichedAt! ? 1 : a.enrichedAt! > b.enrichedAt! ? -1 : 0))
  .slice(0, 5);

// コレクション: featured を最大6件。足りなければ更新の新しい順で補う
const all = getCollections();
const featured = all.filter((c) => c.featured);
const rest = all.filter((c) => !c.featured).sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));
const collections = [...featured, ...rest].slice(0, 4);

let n = 0;
const idx = () => String(++n).padStart(2, '0');
---

<BaseLayout path={paths.home()}>
  <h1 class="visually-hidden">Indie Atlas — まだ知らないインディーゲームに出会う</h1>
  <div class="container home">
    {news.length > 0 && <HeroCarousel articles={news} />}

    {events.length > 0 && (
      <section class="section" aria-labelledby="events-h">
        <SectionHeading
          id="events-h"
          index={idx()}
          en="Upcoming events"
          title="これからのイベント"
          linkPath={paths.events()}
          linkLabel="カレンダー"
        />
        <ul class="event-row">
          {events.map((e) => (
            <li>
              <EventCard event={e} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section" aria-labelledby="recent-h">
      <SectionHeading
        id="recent-h"
        index={idx()}
        en="New arrivals"
        title="最近収録した作品"
        linkPath={paths.games()}
        linkLabel="すべての作品"
      />
      <GameGrid games={recent} eagerCount={0} />
    </section>

    {enriched.length > 0 && (
      <section class="section" aria-labelledby="enriched-h">
        <SectionHeading id="enriched-h" index={idx()} en="Updated" title="最近情報が充実した作品" />
        <GameGrid games={enriched} notes={Object.fromEntries(enriched.map((g) => [g.id, g.enrichedNote ?? '']))} />
      </section>
    )}

    {collections.length > 0 && (
      <section class="section" aria-labelledby="collections-h">
        <SectionHeading
          id="collections-h"
          index={idx()}
          en="Collections"
          title="コレクション"
          linkPath={paths.collections()}
          linkLabel="すべてのコレクション"
        />
        <ul class="collection-grid">
          {collections.map((c) => (
            <li>
              <CollectionCard collection={c} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {latest.length > 0 && (
      <section class="section" aria-labelledby="news-h">
        <SectionHeading
          id="news-h"
          index={idx()}
          en="Latest news"
          title="新着の記事"
          linkPath={paths.articles()}
          linkLabel="すべての記事"
        />
        <ArticleList articles={latest} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* ホームは情報を詰めて並べる。区画どうしの間をつめ、見出しを小さくする */
  .home :global(.section) {
    padding-block: var(--space-5) var(--space-3);
  }
  .home :global(.section-heading) {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
  }
  .home :global(.section-heading h2) {
    font-size: 1.25rem;
  }
  .home :global(.game-grid) {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .home :global(.article-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }
  .home :global(.article-item) {
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
  }
  @media (max-width: 1100px) {
    .home :global(.game-grid) {
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    }
  }
  @media (max-width: 900px) {
    .home :global(.article-list) {
      grid-template-columns: 1fr;
    }
  }
  .home :global(.game-card__body) {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  /* これからのイベントは1行だけ。入りきらない分は横にスクロールする */
  .event-row {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--space-4)) / 4);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 4px 2px;
  }
  .event-row li {
    scroll-snap-align: start;
  }
  @media (max-width: 1023px) {
    .event-row {
      grid-auto-columns: 42%;
    }
  }
  @media (max-width: 640px) {
    .event-row {
      grid-auto-columns: 72%;
    }
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
