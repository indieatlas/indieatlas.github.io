---
import ArticleCardGrid from '../components/ArticleCardGrid.astro';
import CollectionCard from '../components/CollectionCard.astro';
import DailyPick from '../components/DailyPick.astro';
import GameGrid from '../components/GameGrid.astro';
import HomeEvents from '../components/HomeEvents.astro';
import NewsMosaic from '../components/NewsMosaic.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { gamesByAdded, getArticle, getCollections, getEvents, getGame, getPicks, getRanking, homeNews } from '../lib/data.ts';
import { isVenueEvent } from '../lib/events.ts';
import RankingList from '../components/RankingList.astro';
import { amazonBestsellersUrl } from '../lib/amazon.ts';
import ExternalLink from '../components/ExternalLink.astro';
import { paths } from '../lib/urls.ts';

const bestsellers = amazonBestsellersUrl();
const ranking = getRanking();
const rankingTitle = ranking.source === 'steam' ? 'Steam のインディー売れ筋' : 'Amazon の売れ筋';

const byAdded = gamesByAdded();

// 先頭は大きく見せる記事1件と、その横と下に並べる8件
const news = homeNews(9, 0);
const shownNews = new Set(news.featured.map((a) => a.id));

// 今日のピックアップ: 大きな記事の枠で扱っている作品を除いた先頭の3作品
const mosaicGames = new Set(news.featured.flatMap((a) => a.games.filter((g) => g.role === 'primary').map((g) => g.gameId)));
const picks = getPicks()
  .games.filter((p) => !mosaicGames.has(p.gameId))
  .slice(0, 3)
  .map((p) => ({ game: getGame(p.gameId)!, articles: p.articleIds.map((id) => getArticle(id)!).filter(Boolean) }))
  .filter((p) => p.game);
const pickedArticles = new Set(picks.flatMap((p) => p.articles.map((a) => a.id)));

// 記事のカード: 先頭の枠とピックアップに出していない新しい記事（横長のカードを2列で10行）
const moreNews = homeNews(0, 60)
  .rest.filter((a) => !shownNews.has(a.id) && !pickedArticles.has(a.id))
  .slice(0, 20);

// イベント: 会場のイベントを先に4件。長い期間の催し（running）はいつ見ても先頭に残るので出さない。
// 終わったばかりで感想や記事のある会場のイベントと、オンラインのイベント3件を小さく添える
const events = getEvents();
const soon = events.filter((e) => e.phase === 'upcoming' || e.phase === 'ongoing');
const venueEvents = soon.filter(isVenueEvent).slice(0, 4);
const echoes = events
  .filter((e) => isVenueEvent(e) && e.recentlyEnded && e.reports.length + e.articles.length > 0)
  .reverse()
  .slice(0, 2);
const onlineEvents = soon.filter((e) => !isVenueEvent(e)).slice(0, 3);
const hasEvents = venueEvents.length + echoes.length + onlineEvents.length > 0;

// 作品の区画は1行だけにする
const recent = byAdded.slice(0, 5);
const recentIds = new Set(recent.map((g) => g.id));

// 最近情報が充実した作品: enrichedAt の新しい順に5件。ほかの区画に出した作品は除く
const enriched = byAdded
  .filter((g) => g.enrichedAt && !recentIds.has(g.id))
  .sort((a, b) => (a.enrichedAt! < b.enrichedAt! ? 1 : a.enrichedAt! > b.enrichedAt! ? -1 : 0))
  .slice(0, 5);

// コレクション: featured を優先し、足りなければ更新の新しい順で補う
const all = getCollections();
const featured = all.filter((c) => c.featured);
const rest = all.filter((c) => !c.featured).sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));
const collections = [...featured, ...rest].slice(0, 4);
---

<BaseLayout path={paths.home()}>
  <h1 class="visually-hidden">Indie Atlas — まだ知らないインディーゲームに出会う</h1>
  <div class="container home">
    {news.featured.length > 0 && <NewsMosaic featured={news.featured} />}

    {(picks.length > 0 || hasEvents) && (
      <div class="now">
        {picks.length > 0 && (
          <section class="section" aria-labelledby="pick-h">
            <SectionHeading id="pick-h" title="今日のピックアップ" />
            <DailyPick picks={picks} />
          </section>
        )}
        {hasEvents && (
          <section class="section" aria-labelledby="events-h">
            <SectionHeading id="events-h" title="イベント" linkPath={paths.events()} linkLabel="カレンダー" />
            <HomeEvents venue={venueEvents} echoes={echoes} online={onlineEvents} />
          </section>
        )}
      </div>
    )}

    {moreNews.length > 0 && (
      <section class="section" aria-labelledby="news-h">
        <SectionHeading id="news-h" title="記事" linkPath={paths.articles()} />
        <ArticleCardGrid articles={moreNews} layout="row" />
      </section>
    )}

    <section class="section" aria-labelledby="recent-h">
      <SectionHeading id="recent-h" title="最近収録した作品" linkPath={paths.games()} linkLabel="すべての作品" />
      <GameGrid games={recent} eagerCount={0} dateMode="none" />
    </section>

    {enriched.length > 0 && (
      <section class="section" aria-labelledby="enriched-h">
        <SectionHeading id="enriched-h" title="情報が増えた作品" />
        <GameGrid games={enriched} dateMode="none" notes={Object.fromEntries(enriched.map((g) => [g.id, g.enrichedNote ?? '']))} />
      </section>
    )}

    {collections.length > 0 && (
      <section class="section" aria-labelledby="collections-h">
        <SectionHeading id="collections-h" title="コレクション" linkPath={paths.collections()} />
        <ul class="collection-grid">
          {collections.map((c) => (
            <li>
              <CollectionCard collection={c} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {ranking.items.length > 0 ? (
      <section class="section" aria-labelledby="ranking-h">
        <SectionHeading id="ranking-h" title={rankingTitle} linkPath={paths.ranking()} />
        <RankingList items={ranking.items.slice(0, 10)} layout="row" wide={ranking.source === 'steam'} />
      </section>
    ) : (
      bestsellers && (
        <p class="ranking-link">
          <ExternalLink href={bestsellers} sponsored>
            Amazon のゲーム売れ筋ランキング
          </ExternalLink>
        </p>
      )
    )}
  </div>
</BaseLayout>

<style>
  /* ホームは情報を詰めて並べる。区画どうしの間をつめ、見出しを小さくする */
  .home :global(.section) {
    padding-block: var(--space-6) var(--space-2);
  }
  .home :global(.section-heading) {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
  }
  .home :global(.section-heading h2) {
    font-size: 1.25rem;
  }
  .home :global(.game-grid) {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .home :global(.article-item) {
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
  }
  /* 5列に収まらない幅では、1行のまま横にスクロールする */
  @media (max-width: 1100px) {
    .home :global(.game-grid) {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - 2 * var(--space-4)) / 3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-block: 4px;
    }
    .home :global(.game-grid > li) {
      scroll-snap-align: start;
    }
  }
  .home :global(.game-card__body) {
    padding: var(--space-2) var(--space-3) var(--space-3);
  }
  /* スマートフォンでは2枚ほどを見せて、機種などの細かい情報は省く */
  @media (max-width: 640px) {
    .home :global(.game-grid) {
      grid-auto-columns: 44%;
      gap: var(--space-3);
    }
    .home :global(.game-card__meta),
    .home :global(.game-card__original),
    .home :global(.game-card__note) {
      display: none;
    }
    .home :global(.game-card__title) {
      font-size: 0.875rem;
    }
  }
  /* ピックアップとイベントを横に並べる。イベントは細い列にする */
  .now {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    gap: 0 var(--space-6);
  }
  /* ピックアップとイベントの欄は、下の端をそろえて同じ高さにする */
  .now > .section {
    display: flex;
    flex-direction: column;
  }
  .now > .section > :global(:last-child) {
    flex: 1;
  }
  /* 一覧へのリンクのない見出しも、リンクのある見出しと同じ高さにして横で揃える */
  .now :global(.section-heading) {
    min-height: 44px;
    box-sizing: content-box;
  }
  @media (max-width: 1023px) {
    .now {
      grid-template-columns: 1fr;
    }
  }
  .ranking-link {
    margin: var(--space-6) 0 0;
  }
  .ranking-link :global(a) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 56px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }
  .ranking-link :global(a:hover) {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
