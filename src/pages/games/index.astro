---
import GameListing from '../../components/GameListing.astro';
import GameSearch from '../../components/GameSearch.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { paths } from '../../lib/urls.ts';
---

<BaseLayout
  title="作品一覧と検索"
  description="収録しているインディーゲームを、タイトル、タグ、機種、日本語対応などで検索できます。"
  path={paths.games()}
  current="games"
>
  <div class="container section">
    <p class="eyebrow">Games</p>
    <h1 id="search" class="page-title">
      作品
    </h1>
    <GameSearch>
      <GameListing page={1} />
    </GameSearch>
  </div>
</BaseLayout>
