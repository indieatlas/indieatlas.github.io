---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/components.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import displayFont from '../assets/fonts/space-grotesk-latin.woff2?url';
import stageBoot from '../scripts/gl/stage-boot.ts?worker&url';
import { site } from '../config/site.ts';
import { absoluteUrl, BASE_PATH, url } from '../lib/urls.ts';

interface Props {
  title?: string; // 未指定ならサイト名だけ
  description?: string;
  path: string; // ベースパスを含まないパス（canonical に使う）
  ogImage?: string; // 外部の画像 URL
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  current?: 'games' | 'articles' | 'collections' | 'events' | 'about';
  canonical?: string; // 絶対 URL で上書きする場合（転送ページ）
  stageTint?: string; // 背景の WebGL に混ぜる色（#rrggbb か CSS の変数名）
  theme?: { dark: Record<string, string>; light: Record<string, string> }; // ページの色を上書きする
}
const {
  title,
  description = site.description,
  path,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  current,
  canonical,
  stageTint,
  theme,
} = Astro.props;
const vars = (m: Record<string, string>) =>
  Object.entries(m)
    .map(([k, v]) => `${k}:${v}`)
    .join(';');
const themeCss = theme
  ? `:root:root{${vars(theme.dark)}}:root:root[data-theme='light']{${vars(theme.light)}}@media (prefers-color-scheme: light){:root:root:not([data-theme]){${vars(theme.light)}}}`
  : undefined;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonicalUrl = canonical ?? absoluteUrl(path);
const image = ogImage ?? absoluteUrl('og-default.png');
const placeholder = url('placeholder.svg');
---

<!doctype html>
<html lang="ja" data-base={BASE_PATH}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <script is:inline>
      // 表示テーマを描画の前に反映する
      document.documentElement.classList.add('js');
      try {
        var c = localStorage.getItem('indieatlas-theme');
        if (c === 'light' || c === 'dark') document.documentElement.dataset.theme = c;
        document.documentElement.dataset.themeChoice = c || 'system';
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ placeholder }}>
      // 外部の画像の読み込みに失敗したら、共通のプレースホルダーに置き換える（05 §5.4.2）
      window.addEventListener(
        'error',
        function (e) {
          var t = e.target;
          if (t && t.tagName === 'IMG' && t.hasAttribute('data-fallback') && !t.dataset.failed) {
            t.dataset.failed = '1';
            t.removeAttribute('srcset');
            t.src = placeholder;
          }
        },
        true,
      );
    </script>
    <script is:inline>
      // 作品の画像を、一覧と作品詳細の間でつなぐ（02 §2.6.5）。名前を常に付けておくと、画面の外の画像が
      // 飛んできたり、同じ作品が2枚あって遷移ごと取り消されたりするので、遷移の直前に画面内の1枚にだけ付ける
      (function () {
        var KEY = 'indieatlas-vt-game';
        var NAME = 'game-hero';
        var GAME = /\/games\/(g_\d{6})\/(?:index\.html)?$/;
        var clicked = null;
        var named = [];
        function gameOf(href) {
          try {
            var m = new URL(href, location.href).pathname.match(GAME);
            return m ? m[1] : null;
          } catch (e) {
            return null;
          }
        }
        function shown(el) {
          var r = el.getBoundingClientRect();
          if (r.width < 8 || r.bottom <= 0 || r.top >= innerHeight || r.right <= 0 || r.left >= innerWidth) return false;
          return el.tagName !== 'IMG' || (el.complete && el.naturalWidth > 0);
        }
        function pick(id) {
          var sel = '[data-vt-game="' + id + '"]';
          var own = clicked && clicked.isConnected && clicked.querySelector(sel);
          if (own && shown(own)) return own;
          var all = document.querySelectorAll(sel);
          for (var i = 0; i < all.length; i++) if (shown(all[i])) return all[i];
          return null;
        }
        function name(el, vt) {
          el.style.viewTransitionName = NAME;
          named.push(el);
          vt.finished.finally(clear);
        }
        function clear() {
          for (var i = 0; i < named.length; i++) named[i].style.viewTransitionName = '';
          named = [];
        }
        addEventListener('click', function (e) {
          clicked = e.target instanceof Element ? e.target.closest('a') : null;
        }, true);
        addEventListener('pageswap', function (e) {
          clear();
          try { sessionStorage.removeItem(KEY); } catch (err) {}
          if (!e.viewTransition || !e.activation || !e.activation.entry) return;
          // 詳細へ行くならその作品、詳細から出るなら今の作品の画像をつなぐ
          var id = gameOf(e.activation.entry.url) || gameOf(location.href);
          var el = id && pick(id);
          if (!el) return;
          name(el, e.viewTransition);
          try { sessionStorage.setItem(KEY, id); } catch (err) {}
        });
        addEventListener('pagereveal', function (e) {
          clear();
          clicked = null;
          var id = null;
          try {
            id = sessionStorage.getItem(KEY);
            sessionStorage.removeItem(KEY);
          } catch (err) {}
          if (!e.viewTransition || !id) return;
          var el = pick(id);
          if (el) name(el, e.viewTransition);
        });
      })();
    </script>
    {themeCss && <style set:html={themeCss} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body data-stage-tint={stageTint}>
    <script is:inline src={stageBoot}></script>
    <SkipLink />
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { applyRelativeTimes } from '../scripts/relative-time.ts';
      applyRelativeTimes();
    </script>
  </body>
</html>
