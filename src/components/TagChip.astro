---
import { paths, url } from '../lib/urls.ts';

interface Props {
  id: string;
  label: string;
  link?: boolean;
}
const { id, label, link = true } = Astro.props;
---

{link ? (
  <a class="tag-chip" href={`${url(paths.games())}?tag=${encodeURIComponent(id)}`}>
    <span aria-hidden="true">#</span>
    {label}
  </a>
) : (
  <span class="tag-chip">{label}</span>
)}

<style>
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 30px;
    padding: 2px 12px;
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-size: var(--text-xsmall);
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  a.tag-chip {
    min-height: 44px;
  }
  .tag-chip span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  a.tag-chip:hover,
  a.tag-chip:focus-visible {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
    box-shadow: none;
    outline: none;
  }
  a.tag-chip:hover span,
  a.tag-chip:focus-visible span {
    color: inherit;
  }
</style>
