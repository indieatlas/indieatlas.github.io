---
import { paths, url } from '../lib/urls.ts';

interface Props {
  id: string;
  label: string;
  link?: boolean;
}
const { id, label, link = true } = Astro.props;
---

{link ? (
  <a class="tag-chip" href={`${url(paths.games())}?tag=${encodeURIComponent(id)}`}>
    {label}
  </a>
) : (
  <span class="tag-chip">{label}</span>
)}

<style>
  .tag-chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 2px 14px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-xsmall);
    font-weight: 600;
    text-decoration: none;
  }
  a.tag-chip {
    min-height: 44px;
  }
  a.tag-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
