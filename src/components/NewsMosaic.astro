---
import type { SiteArticle } from '../../schema/site-data.ts';
import NewsTile from './NewsTile.astro';

// ホームの先頭。大きく見せる記事を1件と、その横に2件ずつ切り替わる記事の枠
interface Props {
  featured: SiteArticle[];
}
const { featured } = Astro.props;
const [lead, ...side] = featured;
const pages: SiteArticle[][] = [];
for (let i = 0; i < side.length; i += 2) pages.push(side.slice(i, i + 2));
---

<section class="news-mosaic" aria-label="注目の記事">
  {lead && (
    <div class="news-mosaic__lead">
      <NewsTile article={lead} size="lg" eager />
    </div>
  )}
  {pages.length > 0 && (
    <div class="news-mosaic__side" data-rotator>
      {pages.map((p, i) => (
        <div class="news-mosaic__page" data-page aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true}>
          {p.map((a) => (
            <NewsTile article={a} eager={i === 0} />
          ))}
        </div>
      ))}
      {pages.length > 1 && (
        <div class="news-mosaic__controls" data-controls hidden>
          {pages.map((_, i) => (
            <button
              type="button"
              class="dot"
              data-dot={i}
              aria-label={`${i + 1}組目の記事`}
              aria-pressed={i === 0 ? 'true' : 'false'}
            />
          ))}
          <button type="button" class="pause" data-pause aria-pressed="false" aria-label="自動の切り替えを止める">
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <rect x="4" y="3" width="3" height="10"></rect>
              <rect x="9" y="3" width="3" height="10"></rect>
            </svg>
          </button>
        </div>
      )}
    </div>
  )}
</section>

<script>
  import { startRotators } from '../scripts/rotator.ts';
  startRotators();
</script>

<style>
  .news-mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4px;
    height: clamp(22rem, 36vw, 32rem);
    margin-top: var(--space-4);
  }
  .news-mosaic__side {
    position: relative;
    display: grid;
  }
  .news-mosaic__page {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 4px;
    transition:
      opacity 500ms var(--ease-out),
      visibility 500ms;
  }
  .news-mosaic__page[aria-hidden='true'] {
    opacity: 0;
    visibility: hidden;
  }
  .news-mosaic__controls {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px 4px;
    background: rgb(4 5 8 / 0.72);
  }
  .news-mosaic__controls[hidden] {
    display: none;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dot::before {
    content: '';
    width: 8px;
    height: 8px;
    background: rgb(255 255 255 / 0.45);
    transition: background var(--dur-fast);
  }
  .dot[aria-pressed='true']::before {
    width: 18px;
    background: #fff;
  }
  .pause {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
  }
  .pause svg {
    width: 12px;
    height: 12px;
  }
  .pause[aria-pressed='true'] svg rect:last-child {
    display: none;
  }
  .dot:focus-visible,
  .pause:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }
  @media (max-width: 900px) {
    .news-mosaic {
      grid-template-columns: 1fr;
      height: auto;
    }
    .news-mosaic__lead {
      height: 20rem;
    }
    .news-mosaic__page {
      grid-template-rows: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      height: 11rem;
    }
  }
  @media (max-width: 560px) {
    .news-mosaic__lead {
      height: 17rem;
    }
    .news-mosaic__page {
      grid-template-columns: none;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      height: 17rem;
    }
  }
</style>
