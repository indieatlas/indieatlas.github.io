---
import type { SiteArticle } from '../../schema/site-data.ts';
import NewsTile from './NewsTile.astro';

// ホームの先頭。大きく見せる記事を1件と、その横と下に並べる記事。切り替えずに一度に見せる
interface Props {
  featured: SiteArticle[];
}
const { featured } = Astro.props;
const [lead, ...rest] = featured;
---

<section class="news-mosaic" aria-label="注目の記事">
  {lead && (
    <div class="news-mosaic__lead">
      <NewsTile article={lead} size="lg" eager />
    </div>
  )}
  {rest.map((a, i) => (
    <div class="news-mosaic__item">
      <NewsTile article={a} size="sm" eager={i < 4} />
    </div>
  ))}
</section>

<style>
  /* 4列。大きな記事が左の2列と2行を占め、右に4件、下の行に4件を並べる */
  .news-mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(9.5rem, 13vw, 12rem);
    gap: 6px;
    margin-top: var(--space-4);
  }
  .news-mosaic__lead {
    grid-column: span 2;
    grid-row: span 2;
  }
  .news-mosaic > div {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .news-mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 10rem;
    }
    .news-mosaic__lead {
      grid-row: span 2;
    }
  }
  @media (max-width: 560px) {
    .news-mosaic {
      grid-auto-rows: 10rem;
      gap: 4px;
    }
  }
</style>
