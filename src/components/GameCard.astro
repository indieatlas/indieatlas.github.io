---
import type { SiteGame } from '../../schema/site-data.ts';
import { genreColorVar } from '../lib/data.ts';
import { formatCardDate, isoDate } from '../lib/format.ts';
import { paths, url } from '../lib/urls.ts';
import GameImage from './GameImage.astro';
import JapaneseSupportBadge from './JapaneseSupportBadge.astro';
import PlatformList from './PlatformList.astro';
import ReleaseLabel from './ReleaseLabel.astro';

// 作品カード（02 §2.3.3）。カード全体を作品詳細へのリンクにし、中にリンクを入れ子にしない
interface Props {
  game: SiteGame;
  eager?: boolean;
  note?: string;
  headingLevel?: 2 | 3;
  dateMode?: 'added' | 'updated' | 'none';
}
const { game, eager = false, note, headingLevel = 3, dateMode = 'added' } = Astro.props;
const badge = game.prominence === 'landmark' ? '定番' : game.prominence === 'notable' ? '人気' : undefined;
const dateValue = dateMode === 'updated' ? game.activityAt : game.addedAt;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const dev = game.developers[0];
const devText = dev ? (game.developers.length > 1 ? `${dev.name} ほか` : dev.name) : '開発者不明';
const showOriginal = game.title.original !== game.title.display;
---

<a
  class:list={['game-card', { [`is-${game.prominence}`]: game.prominence !== 'standard' }]}
  href={url(paths.game(game.id))}
  data-game-id={game.id}
  style={`--genre-color: ${genreColorVar(game.primaryGenre)}`}
>
  <div class="game-card__media">
    <GameImage game={game} eager={eager} />
    {badge && <span class="game-card__badge">{badge}</span>}
  </div>
  <div class="game-card__body">
    <Heading class="game-card__title">{game.title.display}</Heading>
    {showOriginal && (
      <p class="game-card__original" lang={game.title.originalLang}>
        {game.title.original}
      </p>
    )}
    <p class:list={['game-card__developer', { 'is-unknown': !dev }]}>{devText}</p>
    <p class="game-card__release">
      <ReleaseLabel release={game.release} compact />
    </p>
    <div class="game-card__meta">
      <PlatformList platforms={game.platforms} max={4} />
      <JapaneseSupportBadge support={game.japaneseSupport} />
    </div>
    {note && <p class="game-card__note">{note}</p>}
    {dateMode !== 'none' && (
      <p class="game-card__added">
        {dateMode === 'updated' ? '更新' : '収録'}{' '}
        <time datetime={isoDate(dateValue)}>{formatCardDate(dateValue)}</time>
      </p>
    )}
  </div>
</a>
