---
import type { SiteDeveloper } from '../../schema/site-data.ts';
import { getDevelopers, getGame } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';

// 開発元、またはパブリッシャーの一覧。収録作品の多い順
interface Props {
  role: 'developer' | 'publisher';
}
const { role } = Astro.props;
const idsOf = (d: SiteDeveloper) => (role === 'developer' ? d.developed : d.published);
const studios = getDevelopers()
  .filter((d) => idsOf(d).length > 0)
  .sort((a, b) => idsOf(b).length - idsOf(a).length || a.name.localeCompare(b.name, 'ja'));
const pathOf = (id: string) => (role === 'developer' ? paths.developer(id) : paths.publisher(id));
---

<ul class="studio-grid">
  {studios.map((d) => {
    const ids = idsOf(d);
    const thumbs = ids.map((id) => getGame(id)).filter((g) => g?.image).slice(0, 3);
    return (
      <li>
        <a class="studio-card" href={url(pathOf(d.id))}>
          <span class="thumbs" aria-hidden="true">
            {thumbs.map((g) => (
              <img src={g!.image!.url} alt="" width="460" height="215" loading="lazy" decoding="async" />
            ))}
          </span>
          <span class="body">
            <span class="name">{d.name}</span>
            <span class="meta">{ids.length}作品</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }
  .studio-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out);
  }
  .studio-card:hover,
  .studio-card:focus-visible {
    background: var(--color-surface-raised);
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
    outline: none;
  }
  .thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 2px;
    aspect-ratio: 460 / 150;
    overflow: hidden;
    background: var(--color-surface-raised);
  }
  .thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
  }
  .name {
    font-weight: 800;
  }
  .meta {
    font-size: var(--text-xsmall);
    color: var(--color-text-muted);
  }
</style>
