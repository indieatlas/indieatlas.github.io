---
import type { SiteGame } from '../../schema/site-data.ts';

// 作品詳細のスクリーンショット。押すと大きな画像を重ねて表示する
interface Props {
  game: SiteGame;
}
const { game } = Astro.props;
const shots = game.screenshots;
const credits = [...new Set(shots.map((s) => s.credit).filter(Boolean))];
---

{shots.length > 0 && (
  <section class="screenshots" aria-labelledby="shots-h" data-gallery>
    <h2 id="shots-h" class="visually-hidden">スクリーンショット</h2>
    <ul class="strip">
      {shots.map((s, i) => (
        <li>
          <a href={s.large} target="_blank" rel="noopener" data-shot={i} aria-label={`${s.alt}（${i + 1}枚目を拡大）`}>
            <img
              src={s.url}
              alt=""
              width={s.width ?? 889}
              height={s.height ?? 500}
              loading="lazy"
              decoding="async"
              data-fallback
            />
          </a>
        </li>
      ))}
    </ul>
    {credits.length > 0 && <p class="credit">画像: {credits.join('、')}</p>}
    <dialog class="viewer" aria-label={`${game.title.display} のスクリーンショット`}>
      <img src="" alt="" data-viewer-img />
      <div class="viewer-bar">
        <button type="button" class="button" data-viewer-prev aria-label="前の画像">
          ◀
        </button>
        <span class="viewer-count" data-viewer-count></span>
        <button type="button" class="button" data-viewer-next aria-label="次の画像">
          ▶
        </button>
        <button type="button" class="button" data-viewer-close>
          閉じる
        </button>
      </div>
    </dialog>
    <script
      type="application/json"
      data-shots
      set:html={JSON.stringify(shots.map((s) => ({ src: s.large, alt: s.alt })))}
    />
  </section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const shots = JSON.parse(root.querySelector('[data-shots]')!.textContent!) as { src: string; alt: string }[];
    const dialog = root.querySelector('dialog')!;
    const img = root.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const count = root.querySelector<HTMLElement>('[data-viewer-count]')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      img.src = shots[index]!.src;
      img.alt = shots[index]!.alt;
      count.textContent = `${index + 1} / ${shots.length}`;
    };
    root.querySelectorAll<HTMLAnchorElement>('[data-shot]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(Number(a.dataset.shot));
        dialog.showModal();
      }),
    );
    root.querySelector('[data-viewer-prev]')!.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-viewer-next]')!.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-viewer-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>

<style>
  .screenshots {
    margin-bottom: var(--space-8);
  }
  h2 {
    position: relative;
    padding-left: var(--space-4);
    font-size: 1.375rem;
  }
  h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    background: var(--color-signal);
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 32%);
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    position: relative;
  }
  .strip li {
    scroll-snap-align: start;
  }
  .strip a {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-deep);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .strip a:hover img,
  .strip a:focus-visible img {
    transform: scale(1.04);
  }
  .strip a:focus-visible {
    outline: 2px solid var(--color-accent-warm);
    outline-offset: 2px;
  }
  .credit {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  .viewer {
    width: min(96vw, 1280px);
    padding: 0;
    border: 0;
    background: var(--color-bg-deep);
    color: var(--color-text);
    box-shadow: 0 0 0 1px var(--color-border-strong);
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .viewer img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    background: #000;
  }
  .viewer-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
  }
  .viewer-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-right: auto;
  }
  [data-viewer-close] {
    margin-left: var(--space-2);
  }
</style>
