---
import type { SiteRankingItem } from '../../scripts/build/prepare-site.ts';
import { paths, url } from '../lib/urls.ts';
import ExternalLink from './ExternalLink.astro';

// 売れ筋。順位、画像、名前。リンクは Amazon（アソシエイト）。収録作品なら作品ページへのリンクも出す
interface Props {
  items: SiteRankingItem[];
  layout?: 'row' | 'grid';
  wide?: boolean; // 横長の画像（Steam のカプセル画像）
}
const { items, layout = 'grid', wide = false } = Astro.props;
// 機種は別に出すので、商品名の末尾の「- Switch」などは省く
const shortTitle = (t: string) =>
  t.replace(/\s*[-－–]\s*(Nintendo\s*)?(Switch\s*2|Switch|PS5|PS4|Xbox[^-－–]*)\s*$/i, '');
---

<ol class:list={['ranking-list', `is-${layout}`, { 'is-wide': wide }]}>
  {items.map((it, i) => (
    <li>
      <ExternalLink href={it.url} class="item" sponsored={it.store !== 'steam'}>
        <span class:list={['rank', { top: i < 3 }]}>{i + 1}</span>
        <span class="thumb">
          {it.image && (
            <img src={it.image.url} alt="" width={it.image.width} height={it.image.height} loading="lazy" decoding="async" />
          )}
        </span>
        {it.platform && <span class="platform">{it.platform}</span>}
        <span class="title">{shortTitle(it.title)}</span>
        <span class="dest">{it.store === 'steam' ? 'Steam で見る' : 'Amazon で探す'}</span>
      </ExternalLink>
      {it.gameId && (
        <a class="in-catalog" href={url(paths.game(it.gameId))}>
          作品ページ
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .ranking-list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .is-grid {
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  }
  .is-row {
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 9 * var(--space-3)) / 10);
    overflow-x: auto;
    scrollbar-width: none;
  }
  @media (max-width: 1023px) {
    .is-row {
      grid-auto-columns: 9rem;
    }
  }
  .ranking-list :global(.item) {
    position: relative;
    display: grid;
    gap: 4px;
    height: 100%;
    padding: var(--space-2);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }
  .ranking-list :global(.item:hover) {
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
  }
  .ranking-list :global(.external-icon) {
    display: none;
  }
  .rank {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    min-width: 1.75rem;
    padding: 2px 6px;
    background: var(--color-bg-deep);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 800;
    text-align: center;
  }
  .rank.top {
    background: var(--hof-gradient);
    color: var(--hof-ink);
  }
  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #fff;
    overflow: hidden;
  }
  .is-wide .thumb {
    aspect-ratio: 231 / 87;
    background: var(--color-surface-raised);
  }
  .is-wide .thumb img {
    object-fit: cover;
  }
  .ranking-list li {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .dest {
    margin-top: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .in-catalog {
    display: block;
    padding: 4px var(--space-2);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    font-size: var(--text-xsmall);
    font-weight: 700;
    text-align: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .platform {
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--color-accent);
  }
  .title {
    font-size: var(--text-xsmall);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
</style>
