---
import type { SiteGame } from '../../schema/site-data.ts';
import { site } from '../config/site.ts';
import { getAtlas, getStats } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';
import GameImage from './GameImage.astro';

// ホームのヒーロー。静的な表示（02 §2.7.5）を先に描き、WebGL のアトラスは後から重ねる
interface Props {
  featured: SiteGame[]; // 最近収録した作品（静的な表示の6枚）
}
const { featured } = Astro.props;
const atlas = getAtlas();
const stats = getStats();
const slots = [
  { x: 8, y: 14, w: 22 },
  { x: 36, y: 4, w: 18 },
  { x: 62, y: 18, w: 24 },
  { x: 14, y: 58, w: 18 },
  { x: 44, y: 48, w: 22 },
  { x: 74, y: 62, w: 18 },
];
---

<section class="atlas-hero" aria-labelledby="hero-title">
  <div class="sky" aria-hidden="true">
    <div class="static-constellation" data-atlas-fallback>
      <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none">
        <polyline
          points="19,20 45,10 74,26 23,64 55,56 83,68"
          fill="none"
          stroke="currentColor"
          stroke-width="0.15"
          stroke-dasharray="0.6 1"
        ></polyline>
      </svg>
      {featured.slice(0, 6).map((g, i) => (
        <div class="star-card" style={`left:${slots[i]!.x}%; top:${slots[i]!.y}%; width:${slots[i]!.w}%`}>
          <GameImage game={g} eager={i < 4} transition={false} />
        </div>
      ))}
    </div>
    <atlas-canvas data-src={url('atlas.json')} data-game-base={url(paths.games())}></atlas-canvas>
  </div>

  <div class="container hero-content">
    <div class="panel">
      <p class="eyebrow">Indie Atlas</p>
      <h1 id="hero-title">{site.tagline}</h1>
      <p class="lede">
        遊び方や雰囲気が近い作品ほど、近くに並ぶ星図です。{stats.games}
        作品を、出典に基づく情報と記事とともに収録しています。
      </p>
      <form class="hero-search" action={url(paths.games())} method="get" role="search">
        <label for="hero-q" class="visually-hidden">
          作品を検索
        </label>
        <input id="hero-q" name="q" type="search" placeholder="タイトル、タグ、開発者で検索" autocomplete="off" />
        <button type="submit" class="button button-primary">
          検索
        </button>
      </form>
      <p class="list-link">
        <a href={url(paths.games())}>アトラスの作品をリストで見る</a>
      </p>
    </div>
  </div>

  {atlas.legend.length > 0 && (
    <div class="legend" aria-label="アトラスの色の凡例">
      <ul>
        {atlas.legend.map((l, i) => (
          <li>
            <span class="dot" style={`background: var(--atlas-c${i})`} aria-hidden="true" />
            {l.label}
          </li>
        ))}
        <li>
          <span class="dot" style="background: var(--atlas-neutral)" aria-hidden="true" />
          その他
        </li>
      </ul>
    </div>
  )}
</section>

<script>
  import { defineAtlasElement } from '../scripts/gl/atlas-element.ts';
  defineAtlasElement();
</script>

<style>
  atlas-canvas {
    position: absolute;
    inset: 0;
    display: block;
    touch-action: pan-y;
  }
  atlas-canvas :global(canvas) {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
    opacity: 0;
    animation: atlas-in var(--dur-slow) var(--ease-out) forwards;
  }
  @keyframes atlas-in {
    to {
      opacity: 1;
    }
  }
  atlas-canvas :global(.atlas-tooltip) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 15rem;
    padding: var(--space-2);
    border-radius: var(--radius-m);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.5);
    pointer-events: none;
    font-size: var(--text-xsmall);
    line-height: 1.5;
  }
  atlas-canvas :global(.atlas-tooltip img) {
    width: 100%;
    height: auto;
    aspect-ratio: 460 / 215;
    object-fit: cover;
    border-radius: var(--radius-s);
    margin-bottom: var(--space-2);
  }
  atlas-canvas :global(.atlas-tooltip p) {
    margin: 0;
  }
  atlas-canvas :global(.atlas-tooltip__title) {
    font-weight: 700;
    font-size: var(--text-small);
  }
  atlas-canvas :global(.atlas-tooltip__tags),
  atlas-canvas :global(.atlas-tooltip__hint) {
    color: var(--color-text-muted);
  }
  atlas-canvas :global(.atlas-tooltip__release) {
    color: var(--color-accent-warm);
  }
  .atlas-hero {
    position: relative;
    isolation: isolate;
    min-height: min(78vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(60% 70% at 70% 30%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 70%),
      radial-gradient(
        50% 60% at 20% 80%,
        color-mix(in srgb, var(--color-accent-warm) 14%, transparent),
        transparent 70%
      ),
      var(--color-bg-deep);
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .static-constellation {
    position: absolute;
    inset: 6% 2% 10% 38%;
    color: var(--color-accent-warm);
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .star-card {
    position: absolute;
    border-radius: var(--radius-m);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 0 32px -8px color-mix(in srgb, var(--color-accent) 50%, transparent);
    opacity: 0.85;
  }
  :global(.atlas-ready) .static-constellation {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    pointer-events: none;
  }
  .panel {
    pointer-events: auto;
    max-width: 34rem;
    padding: var(--space-7);
    border-radius: var(--radius-l);
    border: 1px solid var(--color-border);
    background: var(--color-overlay);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .panel h1 {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.625rem);
  }
  .lede {
    color: var(--color-text-muted);
  }
  .hero-search {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-3);
  }
  .hero-search input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
  }
  .list-link {
    margin: 0;
    font-size: var(--text-small);
  }
  .legend {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    max-width: 22rem;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m);
    background: var(--color-overlay);
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
  }
  .legend ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
  }
  @media (max-width: 760px) {
    .atlas-hero {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      padding-top: 52vw;
    }
    .static-constellation {
      inset: 2% 2% auto 2%;
      height: 50vw;
    }
    .panel {
      padding: var(--space-5);
    }
    .legend {
      position: static;
      margin: var(--space-3) var(--space-4) var(--space-4);
      max-width: none;
    }
  }
</style>
