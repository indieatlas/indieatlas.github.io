---
import type { SiteArticle } from '../../schema/site-data.ts';
import ArticleItem from './ArticleItem.astro';

interface Props {
  articles: SiteArticle[];
  forGame?: string;
  columns?: 1 | 2; // 2 なら広い画面で2列に並べる
}
const { articles, forGame, columns = 1 } = Astro.props;
---

<ul class:list={['article-list', { 'article-list--2': columns === 2 }]}>
  {articles.map((a) => (
    <li>
      <ArticleItem article={a} forGame={forGame} />
    </li>
  ))}
</ul>

<style>
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .article-list--2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
</style>
