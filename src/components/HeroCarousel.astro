---
import type { SiteArticle, SiteGame } from '../../schema/site-data.ts';
import { getGame } from '../lib/data.ts';
import { ARTICLE_KIND_LABELS, formatCardDate, isoDate } from '../lib/format.ts';
import { paths, url } from '../lib/urls.ts';
import ExternalLink from './ExternalLink.astro';

// ホームの最新情報のカルーセル（02 §2.3.2）。新しい記事を OGP 画像とともに並べる。
// 広い画面では3件、中くらいでは2件、狭い画面では1件ずつ見せる。JS がなければ横にスクロールして読める
interface Props {
  articles: SiteArticle[];
}
const { articles } = Astro.props;
const slides = articles.map((a) => {
  const games = a.games.map((g) => getGame(g.gameId)).filter((g): g is SiteGame => !!g);
  const main = games[0]!;
  const image = a.image
    ? { src: url(a.image.path), width: a.image.width, height: a.image.height }
    : main.image
      ? { src: main.image.url, width: main.image.width ?? 460, height: main.image.height ?? 215 }
      : undefined;
  return { a, games, main, image };
});
---

<section class="hero-carousel" aria-roledescription="carousel" aria-labelledby="latest-h" data-carousel>
  <div class="head">
    <div>
      <p class="eyebrow">Latest</p>
      <h2 id="latest-h">最新情報</h2>
    </div>
    <div class="controls" data-controls hidden>
      <p class="counter" aria-live="polite">
        <span data-counter>01</span> / {String(slides.length).padStart(2, '0')}
      </p>
      <button type="button" class="nav" data-prev aria-label="前の情報">
        <span aria-hidden="true">◀</span>
      </button>
      <button type="button" class="nav" data-next aria-label="次の情報">
        <span aria-hidden="true">▶</span>
      </button>
      <button type="button" class="pause" data-pause aria-pressed="false">
        自動再生を止める
      </button>
    </div>
  </div>
  <div class="track" data-track tabindex="0" aria-label="最新情報の一覧">
    {slides.map((s, i) => (
      <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} data-slide>
        <div class="media">
          {s.image ? (
            <img
              src={s.image.src}
              alt=""
              width={s.image.width}
              height={s.image.height}
              loading={i < 3 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
              data-fallback
            />
          ) : (
            <div class="media-empty" />
          )}
          <span class="index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
        <div class="body">
          <p class="meta">
            <span class="kind">{ARTICLE_KIND_LABELS[s.a.kind]}</span>
            <span>{s.a.outlet.name}</span>
            {s.a.publishedAt && <time datetime={isoDate(s.a.publishedAt)}>{formatCardDate(s.a.publishedAt)}</time>}
          </p>
          <h3 class="title" lang={s.a.lang}>
            <ExternalLink href={s.a.url}>{s.a.title ?? `${s.a.outlet.name} の記事`}</ExternalLink>
          </h3>
          <p class="games">
            <a href={url(paths.game(s.main.id))}>
              <span aria-hidden="true">▶</span> {s.main.title.display}
            </a>
            {s.games.length > 1 && <span class="more">ほか{s.games.length - 1}作品</span>}
          </p>
        </div>
      </article>
    ))}
  </div>
  <div class="progress" aria-hidden="true">
    <span data-progress></span>
  </div>
</section>

<script>
  import { defineCarousel } from '../scripts/carousel.ts';
  defineCarousel();
</script>

<style>
  .hero-carousel {
    --visible: 3;
    --gap: var(--space-5);
    padding-top: var(--space-7);
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .controls[hidden] {
    display: none;
  }
  .counter {
    margin: 0 var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .counter span {
    color: var(--color-text);
  }
  .nav,
  .pause {
    min-width: 44px;
    min-height: 44px;
    border: 0;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-size: 0.6875rem;
  }
  .pause {
    padding: 0 var(--space-3);
    font-size: var(--text-xsmall);
    color: var(--color-text-muted);
  }
  .nav:hover,
  .nav:focus-visible,
  .pause:hover,
  .pause:focus-visible {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
    box-shadow: none;
    outline: none;
  }
  .track {
    /* 読み上げ用の隠し文字（position: absolute）を、スクロールの範囲の中に収める */
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--visible) - 1) * var(--gap)) / var(--visible));
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 6px 4px;
    margin: -6px -4px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--color-accent-warm);
    outline-offset: 2px;
  }
  .slide {
    position: relative;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .slide:hover,
  .slide:focus-within {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
  }
  .media {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-deep);
  }
  .media img,
  .media-empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .slide:hover .media img {
    transform: scale(1.04);
  }
  .index {
    position: absolute;
    left: 0;
    top: 0;
    padding: 4px 10px;
    background: rgb(0 0 0 / 0.72);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4) var(--space-4);
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--text-xsmall);
    color: var(--color-text-muted);
  }
  .meta time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title :global(a) {
    color: var(--color-text);
    text-decoration: none;
  }
  .title :global(a:hover) {
    text-decoration: underline;
  }
  .games {
    margin: auto 0 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xsmall);
  }
  .games a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }
  .games a span {
    font-size: 0.5625rem;
    color: var(--color-signal);
  }
  .games a:hover {
    color: var(--color-accent);
  }
  .more {
    color: var(--color-text-muted);
  }
  .progress {
    height: 2px;
    margin-top: var(--space-4);
    background: var(--color-border);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    width: var(--progress, 0%);
    background: var(--color-signal);
    transition: width var(--dur-slow) var(--ease-out);
  }
  @media (max-width: 1023px) {
    .hero-carousel {
      --visible: 2;
    }
  }
  @media (max-width: 640px) {
    .hero-carousel {
      --visible: 1;
    }
    .track {
      grid-auto-columns: 86%;
    }
    .pause {
      display: none;
    }
  }
</style>
