---
import type { SiteEvent } from '../../schema/site-data.ts';
import { url } from '../lib/urls.ts';

// ホームの「これからのイベント」の小さなカード。画像、日付、名前だけを見せ、案内のページへ移る
interface Props {
  event: SiteEvent;
}
const { event: e } = Astro.props;
const d = e.start;
---

<a class="event-card" href={e.url} target="_blank" rel="noopener">
  <div class="media" aria-hidden="true">
    {e.image ? (
      <img
        src={url(e.image.path)}
        alt=""
        width={e.image.width}
        height={e.image.height}
        loading="lazy"
        decoding="async"
        data-fallback
      />
    ) : (
      <span class="poster">{e.nameEn ?? e.name}</span>
    )}
    <span class="date">
      {'month' in d ? `${d.month}/` : ''}
      {d.precision === 'day' ? d.day : ''}
      {e.phase === 'ongoing' && <span class="now">{e.startKey === e.endKey ? '本日' : '開催中'}</span>}
    </span>
  </div>
  <p class="name">{e.name}</p>
  <p class="when">
    {e.dateLabel}
    {e.location ? ` ・ ${e.location.city ?? e.location.venue}` : ' ・ オンライン'}
  </p>
  <span class="visually-hidden">（新しいタブで開く）</span>
</a>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .event-card:hover,
  .event-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
    outline: none;
  }
  .media {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-deep);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-3);
    background: radial-gradient(
      120% 90% at 0% 0%,
      color-mix(in srgb, var(--color-signal) 40%, transparent),
      transparent 60%
    );
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
  .date {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    gap: 6px;
    padding: 4px 10px;
    background: rgb(0 0 0 / 0.75);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .now {
    padding: 0 6px;
    background: var(--color-signal);
    color: var(--color-on-signal);
  }
  .name {
    margin: var(--space-3) var(--space-4) 0;
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .when {
    margin: 2px var(--space-4) var(--space-4);
    font-size: var(--text-xsmall);
    color: var(--color-text-muted);
  }
</style>
