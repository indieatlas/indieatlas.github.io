---
import type { SiteGame } from '../../schema/site-data.ts';
import GameCard from './GameCard.astro';

interface Props {
  games: SiteGame[];
  eagerCount?: number;
  notes?: Record<string, string>;
  headingLevel?: 2 | 3;
  dateMode?: 'added' | 'updated';
}
const { games, eagerCount = 0, notes = {}, headingLevel = 3, dateMode = 'added' } = Astro.props;
---

<ul class="game-grid">
  {games.map((g, i) => (
    <li class="card-slot">
      <GameCard game={g} eager={i < eagerCount} note={notes[g.id]} headingLevel={headingLevel} dateMode={dateMode} />
    </li>
  ))}
</ul>
