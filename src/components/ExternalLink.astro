---
// 外部リンク（02 §2.4.4）。新しいタブで開き、noreferrer は付けない
interface Props {
  href: string;
  class?: string;
  lang?: string;
  sponsored?: boolean; // アフィリエイトのリンク
}
const { href, class: className, lang, sponsored = false } = Astro.props;
---

<a href={href} target="_blank" rel={sponsored ? 'sponsored noopener' : 'noopener'} class={className} lang={lang}>
  <slot />
  <svg
    class="external-icon"
    viewBox="0 0 16 16"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
  >
    <path d="M6 3H3v10h10v-3M9 3h4v4M13 3L7 9"></path>
  </svg>
  <span class="visually-hidden">（新しいタブで開く）</span>
</a>
