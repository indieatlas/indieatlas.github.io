---
import { paths, url } from '../lib/urls.ts';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: 'games' | 'articles' | 'collections' | 'about';
}
const { current } = Astro.props;
const nav = [
  { key: 'games', label: '作品', en: 'Games', href: url(paths.games()) },
  { key: 'articles', label: '記事', en: 'News', href: url(paths.articles()) },
  { key: 'collections', label: 'コレクション', en: 'Collections', href: url(paths.collections()) },
  { key: 'about', label: '運営説明', en: 'About', href: url(paths.about()) },
] as const;
---

<header class="site-header">
  <div class="container inner">
    <a class="home" href={url(paths.home())}>
      <Logo />
      <span class="visually-hidden">（ホーム）</span>
    </a>
    <nav aria-label="主要なナビゲーション">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
              <span class="en" aria-hidden="true">
                {n.en}
              </span>
              <span class="ja">{n.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a
        class="search-link"
        href={url(paths.games()) + '#search'}
        aria-label="作品を検索（/ キー）"
        data-search-shortcut
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M16 16l5 5"></path>
        </svg>
        <span class="search-label">検索</span>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // "/" キーで検索ページの入力欄へ移る（02 §2.3.1）
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    e.preventDefault();
    const input = document.querySelector<HTMLInputElement>('#search-input');
    if (input) {
      input.focus();
      return;
    }
    const link = document.querySelector<HTMLAnchorElement>('[data-search-shortcut]');
    if (link) location.href = link.href;
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg-deep);
    border-bottom: 3px solid var(--color-signal);
  }
  .site-header::after {
    /* 赤い線の下の、黄色の短い線 */
    content: '';
    position: absolute;
    right: 8%;
    bottom: -6px;
    width: 64px;
    height: 3px;
    background: var(--color-accent-warm);
    transform: skewX(var(--skew));
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }
  .home {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    color: var(--color-text-muted);
    text-decoration: none;
    line-height: 1.2;
    isolation: isolate;
  }
  nav a::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    z-index: -1;
    background: var(--color-signal);
    transform: skewX(var(--skew)) scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-snap);
  }
  nav a:hover::before,
  nav a[aria-current='page']::before {
    transform: skewX(var(--skew)) scaleX(1);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-on-signal);
  }
  .en {
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .ja {
    font-weight: 700;
    font-size: var(--text-small);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .search-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    background: var(--color-surface-raised);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
  }
  .search-link:hover {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
  }
  .search-link svg {
    width: 18px;
    height: 18px;
  }
  kbd {
    font-family: var(--font-display);
    font-size: 0.75rem;
    padding: 0 6px;
    border: 1px solid currentColor;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .inner {
      flex-wrap: wrap;
      row-gap: 0;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
    }
    .actions {
      margin-left: auto;
    }
    .search-label,
    kbd {
      display: none;
    }
    .search-link {
      width: 52px;
      justify-content: center;
      padding: 0;
    }
  }
</style>
