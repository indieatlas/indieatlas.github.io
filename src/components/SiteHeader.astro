---
import { paths, url } from '../lib/urls.ts';
import Logo from './Logo.astro';
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: 'games' | 'articles' | 'collections' | 'events' | 'about';
}
const { current } = Astro.props;
const nav = [
  { key: 'games', label: '作品', href: url(paths.games()) },
  { key: 'articles', label: '記事', href: url(paths.articles()) },
  { key: 'collections', label: 'コレクション', href: url(paths.collections()) },
  { key: 'events', label: 'イベント', href: url(paths.events()) },
  { key: 'about', label: '運営説明', href: url(paths.about()) },
] as const;
---

<header class="site-header">
  <div class="container inner">
    <a class="home" href={url(paths.home())}>
      <Logo />
      <span class="visually-hidden">（ホーム）</span>
    </a>
    <nav aria-label="主要なナビゲーション">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a
        class="search-link"
        href={url(paths.games()) + '#search'}
        aria-label="作品を検索（/ キー）"
        data-search-shortcut
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M16 16l5 5"></path>
        </svg>
        <span class="search-label">検索</span>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<SearchDialog />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg-deep) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }
  .home {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
    line-height: 1.25;
    transition: color var(--dur-fast) var(--ease-out);
  }
  nav a::after {
    /* 選択中の項目の下の青い線 */
    content: '';
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 2px;
    height: 2px;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-snap);
  }
  nav a:hover {
    color: var(--color-text);
  }
  nav a:hover::after {
    transform: scaleX(0.4);
  }
  nav a[aria-current='page'] {
    color: var(--color-text);
  }
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .search-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .search-link:hover {
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
  }
  .search-link svg {
    width: 18px;
    height: 18px;
  }
  kbd {
    font-family: var(--font-display);
    font-size: 0.75rem;
    padding: 0 6px;
    border: 1px solid currentColor;
    opacity: 0.7;
  }
  @media (max-width: 900px) {
    .inner {
      flex-wrap: wrap;
      row-gap: 0;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      gap: 0;
    }
    nav li {
      flex: none;
    }
    nav a {
      white-space: nowrap;
      padding: 0 var(--space-3);
    }
    nav a::after {
      left: var(--space-3);
      right: var(--space-3);
    }
    nav li:first-child a {
      padding-left: 0;
    }
    nav li:first-child a::after {
      left: 0;
    }
    .actions {
      margin-left: auto;
    }
    .search-label,
    kbd {
      display: none;
    }
    .search-link {
      width: 52px;
      justify-content: center;
      padding: 0;
    }
  }
</style>
