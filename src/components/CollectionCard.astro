---
import type { SiteCollection } from '../../schema/site-data.ts';
import { getGame } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';
import GameImage from './GameImage.astro';

interface Props {
  collection: SiteCollection;
  headingLevel?: 2 | 3;
}
const { collection, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const covers = collection.items
  .slice(0, 3)
  .map((i) => getGame(i.gameId))
  .filter((g) => g !== undefined);
---

<div class="card-slot collection-slot">
  <a class="collection-card" href={url(paths.collection(collection.id))}>
    <div class="covers" aria-hidden="true">
      {covers.map((g) => (
        <GameImage game={g} transition={false} />
      ))}
    </div>
    <div class="body">
      <p class="count">
        <span>{collection.items.length}</span>作品
      </p>
      <Heading class="title">{collection.title}</Heading>
      <p class="lede">{collection.lede}</p>
    </div>
  </a>
</div>

<style>
  .collection-slot {
    height: 100%;
  }
  .collection-slot::before {
    background: var(--color-accent-warm);
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut-m)), calc(100% - var(--cut-m)) 100%, 0 100%);
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-snap);
  }
  .collection-card:hover,
  .collection-card:focus-visible {
    transform: translate(-2px, -2px);
    outline: none;
  }
  .covers {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 3px;
    aspect-ratio: 16 / 7;
    background: var(--color-signal);
  }
  .covers :global(.game-image) {
    aspect-ratio: auto;
    height: 100%;
  }
  .covers :global(.game-image:first-child) {
    grid-row: span 2;
  }
  .body {
    position: relative;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 3px solid var(--color-accent-warm);
  }
  .count {
    position: absolute;
    right: var(--space-4);
    top: -1.6rem;
    margin: 0;
    padding: 2px 12px;
    background: var(--color-accent-warm);
    color: var(--color-on-warm);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .count span {
    font-size: 1rem;
  }
  .title {
    margin: 0 0 var(--space-1);
    font-size: 1.1875rem;
  }
  .lede {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>
