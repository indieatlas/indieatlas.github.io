---
import type { SiteCollection } from '../../schema/site-data.ts';
import { getGame } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';
import GameImage from './GameImage.astro';

interface Props {
  collection: SiteCollection;
  headingLevel?: 2 | 3;
}
const { collection, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const covers = collection.items
  .slice(0, 3)
  .map((i) => getGame(i.gameId))
  .filter((g) => g !== undefined);
---

<div class="collection-slot">
  <a class="collection-card" href={url(paths.collection(collection.id))}>
    <div class="covers" aria-hidden="true">
      {covers.map((g) => (
        <GameImage game={g} transition={false} />
      ))}
    </div>
    <div class="body">
      <p class="count">{collection.items.length}作品</p>
      <Heading class="title">{collection.title}</Heading>
      <p class="lede">{collection.lede}</p>
    </div>
  </a>
</div>

<style>
  .collection-slot {
    height: 100%;
  }
  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .collection-card:hover,
  .collection-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px var(--color-accent-warm);
    outline: none;
  }
  .covers {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    aspect-ratio: 16 / 7;
    background: var(--color-bg-deep);
    overflow: hidden;
  }
  .covers :global(.game-image) {
    aspect-ratio: auto;
    height: 100%;
  }
  .covers :global(.game-image:first-child) {
    grid-row: span 2;
  }
  .body {
    position: relative;
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .count {
    margin: 0 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .title {
    margin: 0 0 var(--space-1);
    font-size: 1.125rem;
  }
  .lede {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
</style>
