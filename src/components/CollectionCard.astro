---
import type { SiteCollection } from '../../schema/site-data.ts';
import { getGame } from '../lib/data.ts';
import { paths, url } from '../lib/urls.ts';
import GameImage from './GameImage.astro';

interface Props {
  collection: SiteCollection;
  headingLevel?: 2 | 3;
}
const { collection, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const covers = collection.items
  .slice(0, 3)
  .map((i) => getGame(i.gameId))
  .filter((g) => g !== undefined);
---

<a class="collection-card" href={url(paths.collection(collection.id))}>
  <div class="covers" aria-hidden="true">
    {covers.map((g) => (
      <GameImage game={g} transition={false} />
    ))}
    <svg class="constellation" viewBox="0 0 300 120" preserveAspectRatio="none">
      <path
        d="M20 90 L110 40 L190 75 L280 25"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="2 4"
      ></path>
      <circle cx="20" cy="90" r="3"></circle>
      <circle cx="110" cy="40" r="3"></circle>
      <circle cx="190" cy="75" r="3"></circle>
      <circle cx="280" cy="25" r="3"></circle>
    </svg>
  </div>
  <div class="body">
    <Heading class="title">{collection.title}</Heading>
    <p class="lede">{collection.lede}</p>
    <p class="count">{collection.items.length}作品</p>
  </div>
</a>

<style>
  .collection-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-l);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .collection-card:hover {
    border-color: var(--color-accent-warm);
    box-shadow: var(--glow-warm);
  }
  .covers {
    position: relative;
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    aspect-ratio: 16 / 7;
    background: var(--color-bg-deep);
  }
  .covers :global(.game-image) {
    aspect-ratio: auto;
    height: 100%;
  }
  .covers :global(.game-image:first-child) {
    grid-row: span 2;
  }
  .constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-accent-warm);
    fill: var(--color-accent-warm);
    opacity: 0.75;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .body {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .title {
    margin: 0 0 var(--space-1);
    font-size: 1.125rem;
  }
  .lede {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
  .count {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xsmall);
    color: var(--color-accent-warm);
    font-weight: 700;
  }
</style>
