---
import type { SiteArticle } from '../../schema/site-data.ts';
import ArticleCard from './ArticleCard.astro';

// 記事のカードの格子。縦長のカードは広い画面で4列、狭くなるにつれて3列、2列にする。
// 横長のカード（row）は2列で、狭い画面では1列
interface Props {
  articles: SiteArticle[];
  layout?: 'stack' | 'row';
}
const { articles, layout = 'stack' } = Astro.props;
---

<ul class:list={['article-card-grid', { 'article-card-grid--row': layout === 'row' }]}>
  {articles.map((a) => (
    <li>
      <ArticleCard article={a} layout={layout} />
    </li>
  ))}
</ul>

<style>
  .article-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1100px) {
    .article-card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .article-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }
  .article-card-grid--row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 860px) {
    .article-card-grid--row {
      grid-template-columns: 1fr;
    }
  }
</style>
