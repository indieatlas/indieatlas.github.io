---
import { url } from '../lib/urls.ts';

// セクションの見出しと、一覧へのリンク
interface Props {
  id: string; // 見出しの id（aria-labelledby に使う）
  title: string;
  linkPath?: string; // ベースパスを含まないパス
  linkLabel?: string;
}
const { id, title, linkPath, linkLabel = 'もっと見る' } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {linkPath && (
    <a class="more" href={url(linkPath)}>
      {linkLabel}
      <span aria-hidden="true" class="arrow">
        ▶
      </span>
    </a>
  )}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }
  .section-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 48px;
    height: 2px;
    background: var(--color-signal);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .more:hover {
    color: var(--color-text);
  }
  .arrow {
    font-size: 0.5625rem;
    color: var(--color-signal);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .more:hover .arrow {
    transform: translateX(4px);
  }
</style>
