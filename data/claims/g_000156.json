    {
      "id": "c_68ed573f9cd456b8",
      "gameId": "g_000156",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/5129150/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-09T01:22:58Z",
          "quote": "夢の中で、謎めいたケモ耳少女と命がけのローグライトカードゲーム。役を揃え、カードを強化し、強力な能力を手に入れてボスを倒しましょう。負ければ二度と夢から目覚めることはできません。でも、彼女がそばにいるなら、夢の中に残るのも悪くないのかもしれません。",
          "originKey": "store:steam",
          "fetchHash": "sha256:d925677831f29cfec52815ff107b0584b95b16ad7473cd1daedb45c2baa4b2ed"
        }
      ],
      "asOf": "2026-11-09",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-11-09T01:37:56Z",
      "createdAt": "2026-11-09T01:37:56Z",
      "updatedAt": "2026-11-09T01:37:56Z",
      "lastCheckedAt": "2026-11-09T01:22:58Z",
      "createdBy": "llm",
      "createdByRun": "42544889895",
      "field": "summary",
      "value": {
        "ja": "夢の中の因習村を舞台に、ケモ耳の少女タマちゃんと命がけのトランプ勝負を繰り広げるローグライトカードゲーム。ジンラミーを基に役を揃えて「呪い」を減らし、カード強化やルート選択を重ねてボスを目指す。"
      }
    },
