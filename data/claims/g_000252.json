        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/2731030/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-14T03:29:21Z",
          "quote": "進む方向や罠の解除、撤退の判断まで、パーティーの行動を決めるのはあなたが作ったブループリント（設計図）次第",
          "originKey": "store:steam",
          "fetchHash": "sha256:55dd268fef1239a9488114e0638d76fe1e5f18178439cb8ac86009b63f51f138"
        }
