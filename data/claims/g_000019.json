    {
      "id": "c_23292114cdb165a1",
      "gameId": "g_000019",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/1966720/",
          "retrievedAt": "2026-10-27T13:49:01Z",
          "quote": "A co-op horror about scavenging at abandoned moons to sell scrap to the Company.",
          "locator": "steam:appdetails.about_the_game",
          "originKey": "store:steam"
        }
      ],
      "asOf": "2026-10-27",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-10-27T14:47:08Z",
      "createdAt": "2026-10-27T14:47:08Z",
      "updatedAt": "2026-10-27T14:47:08Z",
      "lastCheckedAt": "2026-10-27T13:49:01Z",
      "createdBy": "agent",
      "createdByRun": "local-seed",
      "field": "summary",
      "value": {
        "ja": "会社と契約した作業員となり、廃墟となった衛星でスクラップを回収して利益のノルマを達成する協力ホラー。施設の内部には危険な存在が潜み、仲間との連携が生き残る鍵になる。"
      }
    },
    {
      "id": "c_4e74c6914f65ed06",
      "gameId": "g_000019",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/1966720/",
          "retrievedAt": "2026-10-27T17:13:02Z",
          "quote": "A co-op horror about scavenging at abandoned moons to sell scrap to the Company.",
          "locator": "steam:appdetails.about_the_game",
          "originKey": "store:steam"
        }
      ],
      "asOf": "2026-10-28",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-10-27T17:13:02Z",
      "createdAt": "2026-10-27T17:13:02Z",
      "updatedAt": "2026-10-27T17:13:02Z",
      "lastCheckedAt": "2026-10-27T17:13:08Z",
      "createdBy": "agent",
      "createdByRun": "local-overview",
      "field": "overview",
      "value": {
        "ja": [
          "「会社」に雇われた作業員として、見捨てられた衛星の廃墟からスクラップを回収する協力型ホラー。集めたものを売って、会社が課す利益のノルマを達成しなければならない。",
          "廃墟の中には危険な生き物や罠がひそみ、夜になるとさらに危険が増す。船に残った仲間がレーダーで罠を伝えたり、端末で扉を開けたりして、探索する仲間を支えることもできる。",
          "稼いだお金で、より危険で見返りの大きい衛星へ向かうか、道具や船の飾りを買うかを選ぶ。友人と声を掛け合いながら遊ぶ作品として、配信などを通じて広く遊ばれた。"
        ]
      }
    },
