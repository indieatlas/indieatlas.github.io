        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/3810510/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-15T02:52:27Z",
          "quote": "DERELIKT is a narrative retro FPS built for fans of claustrophobic PS1-era sci-fi horror.",
          "originKey": "store:steam",
          "fetchHash": "sha256:08fbc73febf77ab293f62bf9f4ad5aff3d3d57ec214c0ea05f7fce143ff1c967"
