          "retrievedAt": "2026-11-04T04:25:03Z",
          "quote": "Build your drug empire from the ground up in the grungy west-coast city of Hyland Point.",
          "originKey": "store:steam",
          "fetchHash": "sha256:21d626055c3e07e05d0e465d10664013e4f74f38d735c9a57be5030eddf640b2"
