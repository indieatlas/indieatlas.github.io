    {
      "id": "c_c3eee8c12dc3e429",
      "gameId": "g_000284",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/3629430/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-16T02:51:31Z",
          "quote": "『DREADMOOR』は、かつての大災害で水没し、腐敗が進む世界を舞台にした、一人称視点のダークなフィッシングアドベンチャーゲーム。濁った水で魚を釣り、船をアップグレードし、サバイバル装備をクラフト。水中や陸上に潜む異形の怪物たちと戦おう。",
          "originKey": "store:steam",
          "fetchHash": "sha256:617dd141a245149fe381c2641fb8c292ce2751b255341f618f4ebe61adbb8466"
        }
      ],
      "asOf": "2026-11-16",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-11-16T03:07:29Z",
      "createdAt": "2026-11-16T03:07:29Z",
      "updatedAt": "2026-11-16T03:07:29Z",
      "lastCheckedAt": "2026-11-16T02:51:31Z",
      "createdBy": "llm",
      "createdByRun": "43794325944",
      "field": "summary",
      "value": {
        "ja": "人類の過ちによる大災害で水没した世界を舞台にした一人称視点の釣りアドベンチャー。トロール漁船の舵を取り、点在する集落を巡りながら魚を釣って売買し、船や装備を強化して、変異した怪物との戦いや水没した廃墟の探索に挑む。"
      }
    },
