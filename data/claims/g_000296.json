      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/5354540/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-17T05:13:46Z",
          "quote": "帰りの電車で眠ってしまい、見知らぬ駅で目を覚ましたあなた。そこは、終わらない夜と2つの月が浮かぶ「いるかのいるまち」。手がかりは、夢の中で耳にした「イルカの歌」のみ。不思議な住人たちと会話を交わし、失われた記憶の欠片を集める、幻想浮遊系アドベンチャー。",
          "originKey": "store:steam",
          "fetchHash": "sha256:7fec65c47d74411f86127b0b12cada8f1d164908af512795d9eef7bd99475512"
        }
      ],
      "asOf": "2026-11-17",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-11-17T05:22:41Z",
      "createdAt": "2026-11-17T05:22:41Z",
      "updatedAt": "2026-11-17T05:22:41Z",
      "lastCheckedAt": "2026-11-17T05:13:46Z",
      "createdBy": "llm",
      "createdByRun": "44021724916",
      "field": "summary",
      "value": {
        "ja": "帰りの電車で眠り、終わらない夜と2つの月が浮かぶ「いるかのいるまち」に迷い込んだ主人公が、何かを失った住人たちと会話を重ね、なくしものを探る幻想浮遊系アドベンチャー。"
      }
    },
