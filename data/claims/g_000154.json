    {
      "id": "c_26b934a51c211449",
      "gameId": "g_000154",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/5116770/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-09T01:25:00Z",
          "quote": "『花札ノ巫孤』は、花札×ローグライト×アクションゲームです。巫孤として花札の力で敵を倒し、迷宮を探索して札を集め、自分を強化していきましょう！迷宮の奥で待つボスとの花札バトルでは、集めた手札で役を揃え、強力な力を引き出して勝利を目指せ！",
          "originKey": "store:steam",
          "fetchHash": "sha256:e953178343a5307d6c6f3adf33f56dcf01689c88c5c4d7a4958ec1be94ac650d"
        }
      ],
      "asOf": "2026-11-09",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-11-09T01:37:56Z",
      "createdAt": "2026-11-09T01:37:56Z",
      "updatedAt": "2026-11-09T01:37:56Z",
      "lastCheckedAt": "2026-11-09T01:25:00Z",
      "createdBy": "llm",
      "createdByRun": "42544889895",
      "field": "summary",
      "value": {
        "ja": "花札を題材にしたローグライトアクション。巫孤となって和風の迷宮を進み、部屋を抜けるたびに示される三枚の花札から一枚を選んで強化する。ボス戦では集めた札で役を揃える花札バトルに移行する。"
      }
    },
