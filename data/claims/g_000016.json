    {
      "id": "c_e60a8a6e38795843",
      "gameId": "g_000016",
      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/1145360/",
          "retrievedAt": "2026-10-27T17:13:02Z",
          "quote": "Hades is a god-like rogue-like dungeon crawler that combines the best aspects of Supergiant's critically acclaimed titles",
          "locator": "steam:appdetails.about_the_game",
          "originKey": "store:steam"
        }
      ],
      "asOf": "2026-10-28",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-10-27T17:13:02Z",
      "createdAt": "2026-10-27T17:13:02Z",
