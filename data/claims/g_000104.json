      "scope": {},
      "basis": "editorial",
      "evidence": [
        {
          "kind": "store",
          "url": "https://store.steampowered.com/app/4008030/",
          "sourceId": "steam-store",
          "retrievedAt": "2026-11-06T10:06:29Z",
          "quote": "この世界では、空に無数の浮遊大陸や空中拠点が存在し、それらを行き来しながら物資の輸送や交易、時には空賊退治といった様々な任務に挑みます。",
          "originKey": "store:steam",
          "fetchHash": "sha256:d49f07cd916e83f78e4454a7861f6fba21c59afd0e94e1ad5ad52e416e563516"
        }
      ],
      "asOf": "2026-11-06",
      "status": "adopted",
      "statusReason": "highest-rank",
      "adoptedAt": "2026-11-06T10:20:57Z",
