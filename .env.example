# ローカル実行用の設定。.env にコピーして値を入れる（.env はコミットしない）
# IGDB（Twitch Developers のアプリの Client ID と Client Secret）: https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Amazon Creators API（アソシエイト・セントラルの「Creators API」で作るアプリの資格情報）:
# https://affiliate-program.amazon.com/creatorsapi/docs/en-us/onboarding
# 日本は極東の版 3.3。売れ筋の取得（npm run amazon:ranking）に使う
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=3.3
# OpenCode Go（LLM。レビューの要約などに使う）: https://opencode.ai/docs/go/
OPENCODE_API_KEY=
